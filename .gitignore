# ── 构建产物 ───────────────────────────────────────────────────────────────
.gradle/
# 本仓库内建的 Gradle home（build-apk.mjs 的兜底位置）
.gradle-home/
build/
app/build/
.kotlin/
# Native 构建缓存（CMake/ninja 的中间产物）
.cxx/
app/.cxx/
*.o
*.ninja_deps
*.ninja_log
*.apk
*.aab

# ── 本地配置（含机器专属路径，绝不能进仓库）────────────────────────────────
local.properties
gradle.properties.bak

# ── 依赖 ───────────────────────────────────────────────────────────────────
node_modules/

# ── 大体积构建输入（由脚本重建，进仓库会让 clone 变成 1.5GB）───────────────
#
# ⚠️ 这三项是**构建输入**而不是源码。它们都能再生成，且合计超过 200MB：
#   dsh-runtime.bin   43.9MB  ← tools 侧运行时的 tar.gz，由 pack-runtime.mjs 从
#                              dsh-desktop 的 resources/dsh-runtime 打包而来
#   libnode.so        83.6MB  ← Node 运行时，来自 .vendor/nodejs-mobile-android
#   .vendor/         317.2MB  ← 上面的 zip 与解压产物
# clone 后按 README「首次构建」补齐即可。
app/src/main/assets/bundle/dsh-runtime.bin
app/src/main/assets/bundle/dsh-runtime.tar.gz
app/src/main/assets/bundle/dsh-runtime.tar
app/src/main/jniLibs/**/libnode.so
.vendor/

# EasyTier 的 JNI 动态库（内嵌组网用，合计 23MB）。
# 跟 libnode.so 同理：它们是**构建输入**，由 .github/workflows/easytier-jni.yml
# 交叉编译产出，作为 Actions artifact 归档（保留 90 天），不进仓库。
# 理由：二进制永久增加 23MB 仓库体积，且每次升 EasyTier 版本都是一次
# 无法 review 的大 diff。代价是 clone 后要自己跑一次流水线，
# 脚本见 docs/EASYTIER-INTEGRATION.md。
app/src/main/jniLibs/**/libeasytier_android_jni.so
app/src/main/jniLibs/**/libeasytier_ffi.so
# 该流水线产出的版本记录（随 .so 一起下载，仅供溯源）
app/src/main/jniLibs/**/easytier-commit.txt
app/src/main/jniLibs/**/BUILD-INFO.txt

# 外壳插件在打包时的落位副本（源在 plugins/，这里是 pack-runtime 复制出来的）
app/src/main/assets/bundle/plugins/

# ── 杂项 ───────────────────────────────────────────────────────────────────
*.log
*.linkbak
.DS_Store
Thumbs.db
