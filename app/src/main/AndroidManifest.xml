<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 前台服务承载 Node 引擎（Android 14+ 带 type 启动必须声明对应权限） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ 通知需要；缺失只影响通知显示 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      「所有文件访问权」：让工作区能指到共享存储（/sdcard/...）。
      这是特殊权限 —— 不能弹窗授予，必须跳系统设置页让用户手动开。
      没授予时应用照常工作，只是工作区被限制在私有目录内。
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- dsh web 是 http + token，允许明文（仅连接本机/局域网） -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.DshAndroid"
        android:usesCleartextTraffic="true"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".NodeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          mobile_use 的无障碍服务。
          只能由用户在「设置 → 无障碍」里手动启用，应用无法自行开启；
          关掉开关即彻底停用。BIND_ACCESSIBILITY_SERVICE 由系统持有。
        -->
        <service
            android:name=".MobileUseService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
