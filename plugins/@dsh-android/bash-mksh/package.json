    "./package.json": "./package.json"
  },
  "os": [
    "android"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-bash-sandbox": "*",
    "@deepseek-ai/dsh-subprocess": "*"
  }
}
